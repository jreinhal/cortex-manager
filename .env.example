# CORTEX Environment Variables
# Copy this file to .env and customize

# Repository root directory (overrides config.json)
# REPOS_ROOT=/path/to/your/reference-repos

# Output directory for spawned agent files
# CORTEX_OUTPUT_DIR=/path/to/output

# Server port (default: 3001)
# PORT=3001

# LLM reranker (Qwen2.5 14B Instruct Q4)
# LLM_ENABLED=1
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=qwen2.5-14b-instruct-q4
# LLM_ENDPOINT=http://localhost:8080/v1/chat/completions
# LLM_MODEL_DIR=D:\Models\qwen2.5-14b-instruct-q4
# LLM_MODEL_PATH=D:\Models\qwen2.5-14b-instruct-q4\qwen2.5-14b-instruct-q4.gguf
# LLM_TIMEOUT_MS=10000
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=400
# LLM_TOP_N=6
